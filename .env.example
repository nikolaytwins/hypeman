# ffmpeg / ffprobe (если Next запущен без PATH Homebrew)
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# OpenRouter — доступ к Gemini и др. моделям (сценарий, адаптация ролика; при желании — расшифровка через audio)
# Ключ: https://openrouter.ai/keys — в коде прямой Google Gemini API не используется
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Модель с входом audio (по умолчанию = OPENROUTER_MODEL)
# OPENROUTER_AUDIO_MODEL=google/gemini-2.0-flash-001
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Hypeman

# Расшифровка и SRT: auto | openrouter | openai
# auto — без OPENAI_API_KEY используется OpenRouter (Whisper/OpenAI не нужны).
# openai — только если есть OPENAI_API_KEY и оплата OpenAI.
TRANSCRIPTION_PROVIDER=auto

# ElevenLabs — озвучка (voice.mp3). OpenRouter в этом проекте не подключён как TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Если с VPS приходит 403 и HTML «Just a moment…» (Cloudflare) — исходящий трафик к ElevenLabs через HTTP-прокси (CONNECT для HTTPS).
# Не SOCKS: только http://… или https://… к хосту, который умеет CONNECT. Пример: ELEVENLABS_HTTPS_PROXY=http://user:pass@host:3128
# Допустимо без http:// и в виде host:port@user:pass — приложение соберёт http://user:pass@host:port (спецсимволы в user/pass лучше кодировать вручную).
# ELEVENLABS_HTTPS_PROXY=http://user:pass@host:3128
# ELEVENLABS_USER_AGENT=  # опционально, свой User-Agent

# OpenAI — только если TRANSCRIPTION_PROVIDER=openai или задан ключ и нужен именно Whisper
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1

# Субтитры в final.mp4: libass ждёт TTF/OTF. Положите шрифт в fonts/*.ttf или укажите файл.
# SUBTITLE_FONT_FILE=fonts/PTSans-Regular.ttf
# SUBTITLE_FONT_NAME=PT Sans
# SUBTITLE_FONTS_DIR=/path/to/dir/with-ttf
# Склейка слов Whisper → одна строка на cue (вертикаль 9:16: попробуйте 28–32)
# SUBTITLE_LINE_MAX_CHARS=34
# Макс. длительность одной строки на экране (с)
# SUBTITLE_CUE_MAX_SEC=4.2
# Новая строка после паузы между словами (с)
# SUBTITLE_PAUSE_FLUSH_SEC=0.42
# Зазор между cue, чтобы не перекрывались в libass (с)
# SUBTITLE_GAP_BETWEEN_CUES_SEC=0.04
