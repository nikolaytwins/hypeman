# Production secrets on server: /mnt/data/hypeman/.env.production
# Edit from your Mac (no TTY needed):
#   scp root@178.72.168.156:/mnt/data/hypeman/.env.production ./env.prod && nano env.prod && scp ./env.prod root@178.72.168.156:/mnt/data/hypeman/.env.production
# Or interactive: ssh -t root@178.72.168.156 'nano /mnt/data/hypeman/.env.production'

# ffmpeg (Ubuntu / Selectel)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# OpenRouter — script, adapt reel; transcription when OpenAI is empty (see TRANSCRIPTION_PROVIDER)
# Keys: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_AUDIO_MODEL=google/gemini-2.0-flash-001
OPENROUTER_SITE_URL=https://hypeman.twinlabs.ru
OPENROUTER_APP_NAME=Hypeman

# Transcription: auto | openrouter | openai
# auto — use OpenRouter if OPENAI_API_KEY is empty (no OpenAI card needed).
# openrouter — force OpenRouter for transcribe + SRT.
# openai — Whisper (requires OPENAI_API_KEY + billing).
TRANSCRIPTION_PROVIDER=auto

# ElevenLabs — TTS (voice.mp3)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# OpenAI / Whisper — optional; leave empty if you do not use OpenAI billing
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
